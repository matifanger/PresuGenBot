# Token del bot de Telegram
TELEGRAM_TOKEN= 

# Clave de API de OpenAI
OPENAI_API_KEY=

# Base URL (Util para cuando usamos otro proveedor como OpenRouter. Dejar vacia si se usa default)
OPENAI_BASE_URL=

# Proxy full url (optional, for yt-dlp)
PROXY_FULL=

# PO Token provider URL (set automatically by docker-compose, no need to change)
# POT_PROVIDER_URL=http://pot-provider:4416

# Cobalt API (optional, defaults work out of the box)
# COBALT_API_URL=https://dwnld.nichind.dev
# COBALT_API_KEY=
